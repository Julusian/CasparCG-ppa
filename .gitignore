/.vscode
__pycache__/

# build outputs, written into each distro folder
/*/*.build
/*/*.buildinfo
/*/*.changes
/*/*.deb
/*/*.ddeb
/*/*.dsc
/*/*.tar.*
/*/*.upload

# unpacked upstream sources, only debian/ is tracked
/generic/*/*
!/generic/*/debian
/jammy/*/*
!/jammy/*/debian
/noble/*/*
!/noble/*/debian
/resolute/*/*
!/resolute/*/debian
