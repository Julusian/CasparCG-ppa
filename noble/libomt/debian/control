Package: libomt
Architecture: amd64 arm64
Multi-Arch: same
Pre-Depends: ${misc:Pre-Depends}
# libavahi-client3 and libicu are loaded at runtime, so aren't found by shlibs
Depends: libavahi-client3,
         libicu74,
         ${misc:Depends},
         ${shlibs:Depends}
Description: Open Media Transport library
 Open Media Transport (OMT) sends and receives video, audio and metadata
 over a local network.
 .
 libomt is the C API to libomtnet, compiled to a native library using
 Native AOT. It includes libvmx, the VMX video codec used by OMT.

Package: libomt-dev
Section: libdevel
Architecture: amd64 arm64
Multi-Arch: same
Depends: libomt (= ${binary:Version}), ${misc:Depends}
Description: Open Media Transport library - development files
 Open Media Transport (OMT) sends and receives video, audio and metadata
 over a local network.
 .
 This package contains the libomt C header.
